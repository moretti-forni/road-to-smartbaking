# Development defaults to the local Vite API proxy. For a live build set the full /api/v1 URL.
# VITE_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/api/v1
# Optional: enables CARTO Voyager's familiar road-map styling.
VITE_CARTO_BASEMAP_KEY=
# Optional: takes precedence over the configured Voyager / OpenStreetMap default.
VITE_MAP_TILE_URL=
# Required alongside a non-OpenStreetMap tile URL when the provider specifies attribution.
VITE_MAP_ATTRIBUTION=

# Optional Docker Compose overrides for local PostgreSQL.
# RTSM_DB_PORT=5433
# RTSM_DB_PASSWORD=rtsm_local_only
