VITE_PUBLIC_API_BASE_URL=
# Optional: enables CARTO Voyager's familiar road-map styling.
VITE_CARTO_BASEMAP_KEY=
# Optional: takes precedence over the configured Voyager / OpenStreetMap default.
VITE_MAP_TILE_URL=
# Required alongside a non-OpenStreetMap tile URL when the provider specifies attribution.
VITE_MAP_ATTRIBUTION=
