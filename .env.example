# Dedicated database: never use the existing production database credentials here.
DATABASE_URL=postgresql://rtsm:rtsm_local_only@127.0.0.1:5434/rtsm
RTSM_DB_PORT=5434
# Development-only shared staff token. Production requires individual staff identity/roles.
RTSM_STAFF_TOKEN=
# Add hosted mobile origins when needed, e.g. capacitor://localhost,http://localhost
RTSM_ALLOWED_ORIGINS=
# Web defaults to its own /api/v1. Mobile builds require a hosted HTTPS endpoint.
# NEXT_PUBLIC_API_BASE_URL=https://example.com/api/v1
# Optional explicit preview mode, with bundled catalog content and disabled submissions:
# NEXT_PUBLIC_CATALOG_SOURCE=fixtures
NEXT_PUBLIC_CARTO_BASEMAP_KEY=
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Amplify runtime configuration: IAM role retrieves this JSON secret server-side.
RTSM_RUNTIME_SECRET_ARN=
RTSM_AWS_REGION=eu-west-1
RTSM_APP_ORIGIN=http://127.0.0.1:5173
RTSM_AUTH_SECRET=
RTSM_MAIL_PROVIDER=ses
SES_FROM=noreply-app@morettiforni.com
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Private S3 bucket, delivered via CloudFront with Origin Access Control.
S3_MEDIA_BUCKET=
MEDIA_PUBLIC_BASE_URL=
