# Copy to .env.staging (ignored by Git). Never commit filled-in secrets.
STAGING_DOMAIN=staging.example.com
RTSM_APP_ORIGIN=https://staging.example.com
# Hex-only values avoid URI escaping in the Compose database URL.
# Generate independently: openssl rand -hex 32
STAGING_DB_PASSWORD=
RTSM_AUTH_SECRET=
RTSM_MAIL_PROVIDER=ses
AWS_REGION=eu-west-1
SES_FROM=noreply-app@morettiforni.com
# Use an instance/task role granting ses:SendEmail for this sender.
# SMTP alternative: set RTSM_MAIL_PROVIDER=smtp and fill these server-only values.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
